{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/consulta.js": { "maxDuration": 60 },
    "api/versao.js": { "maxDuration": 60 },
    "api/dados.js": { "maxDuration": 60 },
    "api/img.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/dados/:nome", "destination": "/api/dados?nome=:nome" },
    { "source": "/img/:cod", "destination": "/api/img?cod=:cod" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
