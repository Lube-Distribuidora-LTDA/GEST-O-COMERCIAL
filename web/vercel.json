{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "functions": {
    "api/motor.js": { "maxDuration": 60 },
    "api/img.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/dados/:nome", "destination": "/api/motor?r=dados&nome=:nome" },
    { "source": "/api/abertura", "destination": "/api/motor?r=abertura" },
    { "source": "/api/versao", "destination": "/api/motor?r=versao" },
    { "source": "/api/consulta", "destination": "/api/motor?r=consulta" },
    { "source": "/img/:cod", "destination": "/api/img?cod=:cod" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://painel-lube-distribuidora.vercel.app" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
