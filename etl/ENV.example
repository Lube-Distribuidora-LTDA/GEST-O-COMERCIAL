# Copie este arquivo, renomeie a copia para "ENV" (sem extensao, exatamente esse nome).
# NUNCA compartilhe o "ENV" preenchido: ele guarda senha. Nao vai para o Git.
#
# Na pasta de integracao (P:\INTEGRACAO BI\TRADE\1 - CONFIGURACAO) o ENV e o mesmo dos outros BIs:
# o instalador copia este por cima do da maquina. Editou? Rode o INSTALAR TUDO.bat de novo.
# Na pasta do projeto (Desktop\BI\11. TRADE\etl) o ENV e opcional: sem ele os .bat usam o da integracao.

# --- Oracle / WinThor (somente leitura) -----------------------------------
ORACLE_HOST=ip_do_servidor_oracle
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=nome_do_service
ORACLE_USER=usuario_de_leitura
ORACLE_PASSWORD="coloque_a_senha_aqui"

# --- Supabase (projeto DATA WAREHOUSE, schema trade) ----------------------
# Session pooler (porta 5432). O usuario TEM que terminar no ref do projeto
# (postgres.<ref>): o ETL e o painel conferem isso antes de ler ou gravar e se recusam
# a continuar se o ENV apontar para outro projeto. Senha ENTRE ASPAS (um "#" sem aspas corta a senha).
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.id_do_projeto
SUPABASE_DB_PASSWORD="cole_a_senha_aqui"

# --- Opcional ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Fotos e planilha, so para a TAREFA AGENDADA (ela nao enxerga unidade mapeada: P:, Z:) ----------
# Caminho de rede da pasta de fotos dos produtos (o mesmo lugar do P:\FOTOS_ION) e da planilha de classificacao.
# TRADE_FOTOS=\\servidor\compartilhamento\FOTOS_ION
# TRADE_CLASSIFICACAO="\\servidor\compartilhamento\...\Categoria e subcategoria.xlsx"
# Se o servidor das fotos exige um usuario proprio (a conta da tarefa nao vale la), a conexao e aberta com este
# usuario e com a senha guardada CIFRADA em fotos.cred (ver LEIA-ME da pasta de integracao). A senha nunca vai aqui.
# TRADE_FOTOS_SERVIDOR=\\servidor\compartilhamento
# TRADE_FOTOS_USUARIO=usuario_do_compartilhamento
